# Copy to .env.local and fill in. Same Supabase project as before is fine.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): server-only, used by the daily demo reset
SUPABASE_SECRET_KEY=

# Any long random string. Vercel Cron sends it to /api/cron/reset-demo.
CRON_SECRET=
# Optional: Gemini key for the AI board summary
GOOGLE_GENERATIVE_AI_API_KEY=
